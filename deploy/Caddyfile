{$DOMAIN} {
	encode gzip

	# API → backend Fastify
	handle /api/* {
		reverse_proxy api:8080
	}

	# Página pública de assinatura da formiguinha (/assinar/{token})
	handle /assinar/* {
		rewrite * /assinar.html
		root * /srv
		file_server
	}

	# Frontend estático (SPA)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
