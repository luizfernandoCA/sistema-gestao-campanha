# =====================================================================
# Sistema de Gestao Documental de Campanha — Configuracao de Producao
#
# Copie este arquivo para .env e preencha. Variaveis OBRIGATORIAS quebram
# a aplicacao na inicializacao. Variaveis OPCIONAIS (integracoes) ficam
# em MODO MOCK ate voce inserir a chave correspondente.
#
# Voce pode levantar o sistema inteiro em modo mock e migrar para REAL
# integracao por integracao, sem precisar reiniciar deploy de cada vez.
# =====================================================================

# ---------- OBRIGATORIO: dominio e infraestrutura local ----------
DOMAIN=escritorio.e-negociosinteligentes.com.br
POSTGRES_PASSWORD=GERAR_AQUI            # senha do superuser postgres
APP_DB_PASSWORD=GERAR_AQUI              # senha do papel app_rw (RLS aplicado)
DATABASE_URL=postgresql://app_rw:SENHA@db:5432/campanha
ADMIN_DATABASE_URL=postgresql://postgres:SENHA@db:5432/campanha
PORT=8080
PUBLIC_BASE_URL=https://escritorio.e-negociosinteligentes.com.br
CORS_ORIGINS=https://escritorio.e-negociosinteligentes.com.br

# ---------- OBRIGATORIO: seguranca / criptografia ----------
# JWT_SECRET: 64+ bytes aleatorios. Gerar: openssl rand -hex 64
JWT_SECRET=GERAR_AQUI
# MASTER_KEY_B64: 32 bytes em base64 (KMS local — envelope encryption AES-256-GCM)
# Gerar: openssl rand -base64 32
MASTER_KEY_B64=GERAR_AQUI
# HMAC_KEY: chave para HMAC-SHA-256 de CPF/telefone (dedup sem expor)
# Gerar: openssl rand -hex 64
HMAC_KEY=GERAR_AQUI

# ---------- OBRIGATORIO: object storage (S3/MinIO) ----------
# Bucket SEMPRE privado. Em producao, recomendar Cloudflare R2 ou AWS S3.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=GERAR_AQUI
S3_BUCKET=documentos

# ---------- OPCIONAL: IA (Anthropic Claude) ----------
# Adapter de OCR/extracao/classificacao de divergencias.
# Conta em: https://console.anthropic.com
# Sem chave -> modo MOCK (retorna estrutura vazia, registra observacao).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- OPCIONAL: SMS / WhatsApp / OTP (Twilio) ----------
# Conta em: https://www.twilio.com/console
# - TWILIO_ACCOUNT_SID e TWILIO_AUTH_TOKEN: encontrados no dashboard principal.
# - TWILIO_SMS_FROM: numero comprado na Twilio (formato E.164: +1xxxxxxxxxx).
# - TWILIO_WHATSAPP_FROM: numero do sandbox (+14155238886) ou numero aprovado
#   (formato: whatsapp:+1xxxxxxxxxx).
# Sem credenciais -> modo MOCK; o OTP eh devolvido na resposta da rota
# /api/publico/assinatura/remota/otp APENAS quando em modo mock.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ---------- OPCIONAL: E-mail transacional ----------
# EMAIL_PROVIDER: 'resend' (padrao, recomendado) | 'sendgrid' | 'none'
# - Resend: https://resend.com — DNS via SPF/DKIM/DMARC do dominio.
# - SendGrid: https://sendgrid.com — domain authentication.
# EMAIL_FROM: precisa ser de um dominio verificado no provedor.
EMAIL_PROVIDER=resend
EMAIL_FROM=sistema@e-negociosinteligentes.com.br
RESEND_API_KEY=
SENDGRID_API_KEY=

# ---------- OPCIONAL: Assinatura eletronica externa ICP-Brasil ----------
# Lei 14.063/2020. Promove a assinatura interna (evidenciada) para AVANCADA.
# SIGNATURE_PROVIDER: 'clicksign' (padrao) | 'd4sign' | 'none'
#
# ClickSign:
# - Conta em: https://www.clicksign.com
# - Gerar token de API em: Configuracoes > API
# - CLICKSIGN_API_BASE: 'https://app.clicksign.com' (prod) ou
#   'https://sandbox.clicksign.com' (teste)
CLICKSIGN_API_TOKEN=
CLICKSIGN_API_BASE=https://app.clicksign.com
#
# D4Sign (alternativo):
# - Conta em: https://www.d4sign.com.br
# - Gerar tokenAPI + cryptKey em: Minha Conta > Configuracoes > Token API
# - D4SIGN_SAFE_UUID: UUID do cofre que armazenara os PDFs
D4SIGN_API_TOKEN=
D4SIGN_CRYPT_KEY=
D4SIGN_SAFE_UUID=
D4SIGN_API_BASE=https://secure.d4sign.com.br/api/v1
#
# Use APENAS UM provedor por vez. Definindo SIGNATURE_PROVIDER acima.
SIGNATURE_PROVIDER=clicksign

# ---------- Demonstracao (apenas para seed inicial) ----------
# Remover ou trocar antes de uso real. Seeds carregam usuarios fake
# em ambiente de demonstracao para testar fluxos sem expor dados reais.
DEMO_PASSWORD=Demo@2026
